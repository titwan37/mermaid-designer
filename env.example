# =========================================================================
# Mermaid Designer - Environment Configuration Template
# Copy this file to '.env' (or '.env.local' / '.env.production') to configure.
# =========================================================================

# -------------------------------------------------------------------------
# ENGINE CHOICE 1: OpenRouter (Cloud AI completion - Recommended for VPS)
# To enable this, uncomment the key below and paste your token.
# -------------------------------------------------------------------------
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# -------------------------------------------------------------------------
# ENGINE CHOICE 2: Ollama (Local or Remote Daemon)
# Default fallback when OPENROUTER_API_KEY is not defined.
# -------------------------------------------------------------------------
# Local Ollama (running on the VPS itself on port 11434):
# OLLAMA_HOST=http://localhost:11434

# Remote Ollama (e.g. running on your local desktop, accessed via Tailscale IP):
# OLLAMA_HOST=http://100.x.y.z:11434

# The model to query via Ollama (defaults to qwen2.5-coder:0.5b-base):
# OLLAMA_MODEL=qwen2.5-coder:0.5b-base
